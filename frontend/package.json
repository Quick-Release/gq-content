{
  "name": "@getquick/content",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./metadata/testing": {
      "types": "./dist/metadata-testing.d.ts",
      "import": "./dist/metadata-testing.js"
    },
    "./metadata/content": {
      "types": "./dist/metadata-content.d.ts",
      "import": "./dist/metadata-content.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=22"
