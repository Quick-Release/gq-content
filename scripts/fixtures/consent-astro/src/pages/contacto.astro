---
// A Site component with its own third-party embed: the shared placeholder.
import Page from "../layouts/Page.astro";
import { embedPlaceholder } from "@getquick/content/consent";
import { content } from "../lib/site";

const chrome = await content.pageChrome(Astro.url.origin);
const map = embedPlaceholder({
  service: "google_maps",
  src: "https://www.google.com/maps/embed?pb=!1m18!acme",
  title: "Acme, Lisboa",
  width: 600,
  height: 450,
  language: "pt-PT",
});
---
<Page lang="pt-PT" title="Contacto" chrome={chrome} configuration={content.consentConfiguration(chrome)!}>
  <h1>Contacto</h1>
  <div class="map" set:html={map} />
</Page>
