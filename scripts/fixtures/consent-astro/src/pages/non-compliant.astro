---
// Deliberately non-compliant: a live third-party iframe the suite must fail.
import Page from "../layouts/Page.astro";
import { content } from "../lib/site";
const chrome = await content.pageChrome(Astro.url.origin);
---
<Page lang="pt-PT" title="Non-compliant" chrome={chrome} configuration={content.consentConfiguration(chrome)!}>
  <iframe src="https://www.youtube.com/embed/abcdefghijk" title="Live"></iframe>
</Page>
